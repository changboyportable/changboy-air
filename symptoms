            border: 1px solid #e8e8e8;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .symptom-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

        .symptom-icon {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .symptom-card h3 {
            font-size: 22px;
            margin-bottom: 12px;
