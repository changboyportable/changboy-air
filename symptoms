        <!-- ================= WARNING ================= -->

        <div class="symptom-warning">

            <h3>⚠️ ข้อควรระวัง</h3>

            <p>
                อาการเดียวกันอาจเกิดจากหลายสาเหตุ
                ข้อมูลในหน้านี้เป็นเพียงแนวทางเบื้องต้น
